{
  "name": "zeltranet-website",
  "version": "0.1.0",
  "description": "Zeltranet company website \u2014 static Astro and Tailwind CSS",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "validate": "npm run check && npm run lint && npm run format:check && npm run build"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.151.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  }
}
