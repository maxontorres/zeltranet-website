---
import Arrow from './Arrow.astro';
import { routes, ui, type Locale } from '../i18n';
interface Props {
  lang: Locale;
}
const t = ui[Astro.props.lang];
---

<section class="contact-band container">
  <div>
    <h2>
      {t.bandTitle[0]}
      <br />
      {t.bandTitle[1]}
    </h2>
  </div>
  <a class="button button-primary" href={routes.contact[Astro.props.lang]}>
    {t.discuss}{' '}
    <span class="button-icon">
      <Arrow />
    </span>
  </a>
</section>
