---
interface Props {
  path: string;
  class?: string;
}
const { path, class: className } = Astro.props;
---

<span class:list={['icon-tile', className]} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none">
    <path
      d={path}
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
</span>
