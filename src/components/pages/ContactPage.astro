---
import Base from '../../layouts/Base.astro';
import Arrow from '../Arrow.astro';
import type { Locale } from '../../i18n';
import { email, whatsapp } from '../../data/company';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

// Turnstile spam check. Cloudflare's public test key is used for previews;
// a production build (SITE_URL set) must provide the real site key.
const turnstileTestKey = '1x00000000000000000000AA';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as
  string | undefined;
if (import.meta.env.SITE && !turnstileSiteKey) {
  throw new Error(
    'PUBLIC_TURNSTILE_SITE_KEY must be set for a production build (SITE_URL is set).',
  );
}
const siteKey = turnstileSiteKey ?? turnstileTestKey;

const copy = {
  en: {
    title: 'Contact - Zeltranet',
    description:
      'Send a project enquiry to Zeltranet. Describe your business needs, existing systems, and the software you want to build.',
    heading: ['What needs', 'to work better'],
    intro:
      'A new application. A manual process. Systems that don’t talk to each other. Start with the problem your business needs to solve.',
    startTitle: 'A useful starting point.',
    startText:
      'Tell us what your business does, what is getting in the way, and what a useful outcome would look like.',
    locationLabel: 'LOCATION',
    location: 'Mexico and Vientiane, Laos',
    regionsLabel: 'WORKING WITH BUSINESSES IN',
    regions: ['Mexico, Laos, Thailand, Malaysia,', 'and internationally'],
    languagesLabel: 'LANGUAGES',
    languages: 'English and Spanish',
    noticeLabel: 'DIRECT CONTACT',
    notice: 'Prefer to write directly? Email us or message us on WhatsApp.',
    emailLabel: 'Email Zeltranet',
    whatsappLabel: 'Message Zeltranet on WhatsApp',
    formTitle: 'Send a project enquiry',
    formIntro: 'We will reply to the email address you provide.',
    name: 'Your name',
    company: 'Company',
    email: 'Work email',
    project: 'What would you like to build or improve?',
    placeholder:
      'Your current process, the challenge, and what you want to achieve…',
    note: 'All fields are required.',
    send: 'Send enquiry',
    noscript:
      'The form needs JavaScript. You can also email us or message us on WhatsApp.',
    sending: 'Sending your enquiry…',
    sent: 'Thank you. Your enquiry has been sent, and we will reply by email.',
    invalid: 'Please check the fields and try again.',
    verification:
      'Please complete the spam check above the button, then send again.',
    unavailable: `Your enquiry could not be sent. Please email ${email.display} or message us on WhatsApp.`,
  },
  es: {
    title: 'Contacto - Zeltranet',
    description:
      'Envíe una solicitud de proyecto a Zeltranet. Describa las necesidades de su empresa, sus sistemas actuales y el software que quiere construir.',
    heading: ['¿Qué necesita', 'funcionar mejor'],
    intro:
      'Una nueva aplicación. Un proceso manual. Sistemas que no se comunican entre sí. Empiece por el problema que su empresa necesita resolver.',
    startTitle: 'Un buen punto de partida.',
    startText:
      'Cuéntenos a qué se dedica su empresa, qué obstáculos enfrenta y cómo se vería un resultado útil.',
    locationLabel: 'UBICACIÓN',
    location: 'México y Vientián, Laos',
    regionsLabel: 'TRABAJAMOS CON EMPRESAS EN',
    regions: ['México, Laos, Tailandia, Malasia', 'y a nivel internacional'],
    languagesLabel: 'IDIOMAS',
    languages: 'Inglés y español',
    noticeLabel: 'CONTACTO DIRECTO',
    notice:
      '¿Prefiere escribirnos directamente? Envíenos un correo o un mensaje por WhatsApp.',
    emailLabel: 'Escribir un correo a Zeltranet',
    whatsappLabel: 'Escribir a Zeltranet por WhatsApp',
    formTitle: 'Envíe una solicitud de proyecto',
    formIntro: 'Le responderemos al correo que nos indique.',
    name: 'Su nombre',
    company: 'Empresa',
    email: 'Correo de trabajo',
    project: '¿Qué le gustaría construir o mejorar?',
    placeholder: 'Su proceso actual, el reto y lo que quiere lograr…',
    note: 'Todos los campos son obligatorios.',
    send: 'Enviar solicitud',
    noscript:
      'El formulario necesita JavaScript. También puede escribirnos por correo o por WhatsApp.',
    sending: 'Enviando su solicitud…',
    sent: 'Gracias. Su solicitud fue enviada y le responderemos por correo.',
    invalid: 'Revise los campos e intente de nuevo.',
    verification:
      'Complete la verificación antiespam sobre el botón y vuelva a enviar.',
    unavailable: `No pudimos enviar su solicitud. Escríbanos a ${email.display} o por WhatsApp.`,
  },
}[lang];
const messages = {
  sending: copy.sending,
  sent: copy.sent,
  invalid: copy.invalid,
  verification: copy.verification,
  unavailable: copy.unavailable,
};
---

<Base
  title={copy.title}
  description={copy.description}
  lang={lang}
  page="contact"
>
  <section class="page-intro container">
    <h1>
      {copy.heading[0]}
      <br />
      {copy.heading[1]}
      <span class="blue-text">?</span>
    </h1>
    <p>{copy.intro}</p>
  </section>
  <section class="container contact-layout">
    <aside>
      <h2>{copy.startTitle}</h2>
      <p>{copy.startText}</p>
      <div class="contact-location">
        <span class="eyebrow">{copy.locationLabel}</span>
        <p>{copy.location}</p>
        <span class="eyebrow">{copy.regionsLabel}</span>
        <p>
          {copy.regions[0]}
          <br />
          {copy.regions[1]}
        </p>
        <span class="eyebrow">{copy.languagesLabel}</span>
        <p>{copy.languages}</p>
      </div>
      <div class="notice">
        <span class="eyebrow">{copy.noticeLabel}</span>
        <p>{copy.notice}</p>
        <a
          class="contact-link"
          href={email.href}
          aria-label={`${copy.emailLabel}: ${email.display}`}
        >
          {email.display}
        </a>
        <a
          class="contact-link"
          href={whatsapp.href}
          aria-label={`${copy.whatsappLabel}: ${whatsapp.display}`}
        >
          {whatsapp.display}
        </a>
      </div>
    </aside>
    <form
      id="enquiry-form"
      data-lang={lang}
      data-messages={JSON.stringify(messages)}
    >
      <h2>{copy.formTitle}</h2>
      <p class="form-intro">{copy.formIntro}</p>
      <div class="form-pair">
        <label>
          {copy.name} <span aria-hidden="true">*</span>
          <input name="name" autocomplete="name" required maxlength="120" />
        </label>
        <label>
          {copy.company} <span aria-hidden="true">*</span>
          <input
            name="company"
            autocomplete="organization"
            required
            maxlength="160"
          />
        </label>
      </div>
      <label>
        {copy.email} <span aria-hidden="true">*</span>
        <input
          name="email"
          type="email"
          autocomplete="email"
          required
          maxlength="254"
        />
      </label>
      <label>
        {copy.project} <span aria-hidden="true">*</span>
        <textarea
          name="project"
          rows="6"
          required
          minlength="20"
          maxlength="6000"
          placeholder={copy.placeholder}
        ></textarea>
      </label>
      <div class="hp-field" aria-hidden="true">
        <label>
          Website
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <p class="form-note">{copy.note}</p>
      <div id="turnstile" class="cf-turnstile" data-sitekey={siteKey}></div>
      <button
        id="send-enquiry"
        class="button button-primary"
        type="submit"
        disabled
      >
        {copy.send}{' '}
        <span class="button-icon" aria-hidden="true">
          <Arrow />
        </span>
      </button>
      <noscript>
        <p class="form-note">{copy.noscript}</p>
      </noscript>
      <p id="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>
<script>
  type Result = 'sent' | 'invalid' | 'verification' | 'unavailable';
  type Messages = Record<Result | 'sending', string>;
  interface Turnstile {
    render(
      element: HTMLElement,
      options: Record<string, string | boolean>,
    ): string;
    reset(id?: string): void;
  }
  const turnstileWindow = window as unknown as { turnstile?: Turnstile };

  const form = document.querySelector<HTMLFormElement>('#enquiry-form');
  const button = document.querySelector<HTMLButtonElement>('#send-enquiry');
  const status = document.querySelector<HTMLElement>('#form-status');
  const widget = document.querySelector<HTMLElement>('#turnstile');

  // Load the Turnstile spam check. Narrow phones get the compact widget,
  // because the normal one needs at least 300px.
  if (widget) {
    const script = document.createElement('script');
    script.src =
      'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.addEventListener('load', () => {
      turnstileWindow.turnstile?.render(widget, {
        sitekey: widget.dataset.sitekey ?? '',
        theme: 'dark',
        language: document.documentElement.lang || 'auto',
        size: widget.clientWidth < 300 ? 'compact' : 'flexible',
      });
    });
    document.head.append(script);
  }

  if (form && button && status) {
    const t = JSON.parse(form.dataset.messages ?? '{}') as Messages;
    const show = (text: string, kind: 'info' | 'success' | 'error') => {
      status.textContent = text;
      status.dataset.kind = kind;
    };
    const resetCheck = () => turnstileWindow.turnstile?.reset();

    button.disabled = false;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const token = String(data.get('cf-turnstile-response') ?? '');
      if (!token) {
        show(t.verification, 'error');
        return;
      }

      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      show(t.sending, 'info');
      let result: Result = 'unavailable';
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            company: data.get('company'),
            email: data.get('email'),
            project: data.get('project'),
            website: data.get('website'),
            token,
            lang: form.dataset.lang,
          }),
        });
        const body = (await response.json()) as { result?: Result };
        if (body.result && body.result in t) result = body.result;
      } catch {
        result = 'unavailable';
      }

      button.disabled = false;
      form.removeAttribute('aria-busy');
      if (result === 'sent') {
        form.reset();
        show(t.sent, 'success');
      } else {
        show(t[result], 'error');
      }
      // Turnstile tokens work once, so get a fresh one for the next send.
      resetCheck();
    });
  }
</script>
