---
import Base from '../layouts/Base.astro';
---

<Base
  noindex
  title="Page not found — Zeltranet"
  description="This page could not be found. Return to Zeltranet’s homepage."
>
  <section class="page-intro container not-found">
    <span class="eyebrow">Error 404</span>
    <h1>
      A missing connection<span class="blue-text">.</span>
    </h1>
    <p>The page you’re looking for could not be found.</p>
    <a class="button button-primary" href="/">
      Return to homepage <span aria-hidden="true">→</span>
    </a>
  </section>
</Base>
